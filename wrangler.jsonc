{
  // Tell editors / Wrangler what to validate against
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dataforseo-mcp-worker",
  "main": "build/worker/worker/index-worker-oauth.js",
  "compatibility_date": "2025-07-05",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  // Required secrets (set via the Cloudflare dashboard or `npx wrangler secret put NAME`) :
  //   DATAFORSEO_USERNAME, DATAFORSEO_PASSWORD, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, COOKIE_ENCRYPTION_KEY
  // Required plaintext env vars (set via the Cloudflare dashboard) :
  //   ALLOWED_EMAILS (and/or ALLOWED_DOMAINS)
  // ALLOWED_EMAILS and ALLOWED_DOMAINS are configured directly in the
  // Cloudflare dashboard (Settings -> Variables and Secrets), so they do
  // not appear in this committed file. The `keep_vars: true` flag tells
  // Wrangler to preserve dashboard-set variables at deploy time. See
  // README.md for setup instructions.
  "keep_vars": true,
  "vars": {
    "ENABLED_MODULES": null,
    "DATAFORSEO_FULL_RESPONSE": "false",
    "DATAFORSEO_SIMPLE_FILTER": "true"
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "DataForSEOMcpAgent",
        "name": "MCP_OBJECT"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["DataForSEOMcpAgent"],
      "tag": "v1"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "2efa2ad87fad44b6933a7d62076e0f7e"
    }
  ]
}
